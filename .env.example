# .env.example
#
# Copy this file to ".env" in the project root and fill in the values.
# NEVER commit ".env" (it is listed in .gitignore).
#
# Where to find the values:
#   Firebase Console -> Project settings -> General -> "Your apps" -> Web app -> SDK setup and configuration
#
# On Render (Static Site): Environment -> add the same four variables, then redeploy.
# Vite reads these at BUILD time, so changing them requires a new build.
#
# These web values are not secrets. Never put a service-account key or any other
# private credential in this file or in frontend code.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
